# ============================================================================
# Pi Network Configuration
# ============================================================================
# Your Pi Network API key (get from https://developers.minepi.com)
VITE_PI_API_KEY=your_pi_api_key_here

# Use sandbox mode for testing (true) or production (false)
VITE_PI_SANDBOX=true

# Use mock authentication for local development (true) or real Pi SDK (false)
VITE_USE_MOCK_AUTH=true

# ============================================================================
# API Configuration
# ============================================================================
# Backend API URL
VITE_API_URL=http://localhost:3001

# ============================================================================
# App Configuration
# ============================================================================
# Pi GCV (General Consensus Value) in USD
VITE_GCV_VALUE=314.159

# ============================================================================
# Monitoring & Analytics
# ============================================================================
# Sentry DSN for error tracking (optional)
VITE_SENTRY_DSN=

# Enable Sentry error tracking
VITE_SENTRY_ENABLED=false

# Sentry traces sample rate (0.0 to 1.0)
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Google Analytics ID (optional)
VITE_GA_ID=

# ============================================================================
# Feature Flags
# ============================================================================
# Enable premium features
VITE_ENABLE_PREMIUM=true

# Enable staking features
VITE_ENABLE_STAKING=true

# Enable social features
VITE_ENABLE_SOCIAL=true
