# ============================================================================
# 🔐 MONGODB ATLAS CONFIGURATION - PRODUCTION READY
# ============================================================================
# Ce fichier configure la connexion MongoDB Atlas sécurisée et scalable
# Copiez ce fichier en `.env` et remplissez vos vraies valeurs

# === OPTION 1: URI COMPLÈTE (RECOMMANDÉ) ===
# Format: mongodb+srv://username:password@cluster/database?options
# Obtenez-le depuis: MongoDB Atlas → Connect → Connect your application
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.y87z9is.mongodb.net/pi_academy?retryWrites=true&w=majority

# === OPTION 2: COMPOSANTS SÉPARÉS (ALTERNATIVE) ===
# Utilisez si vous préférez gérer username/password séparément
MONGODB_USERNAME=votre_username
MONGODB_PASSWORD=votre_password_securise
MONGODB_CLUSTER=cluster0.y87z9is.mongodb.net
MONGODB_DATABASE=pi_academy

# ============================================================================
# 🚀 BACKEND SERVER CONFIGURATION
# ============================================================================
PORT=3001
NODE_ENV=production

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# ============================================================================
# 🔑 JWT & AUTHENTICATION
# ============================================================================
# JWT Secret (générez avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_minimum_32_chars

# JWT expiration
JWT_EXPIRES_IN=7d

# Session secret
SESSION_SECRET=your_session_secret_change_this_too_please

# ============================================================================
# 🥧 PI NETWORK CONFIGURATION
# ============================================================================
# Obtenez votre API key: https://developers.minepi.com
PI_API_KEY=your_pi_api_key_here

# Sandbox mode (true = test, false = production)
PI_SANDBOX=true

# Mock auth for development
USE_MOCK_AUTH=true

# ============================================================================
# 💰 BLOCKCHAIN & CRYPTO
# ============================================================================
# Pi GCV (General Consensus Value) en USD
GCV_VALUE=314.159

# Blockchain network
BLOCKCHAIN_NETWORK=testnet

# ============================================================================
# 🔒 SECURITY CONFIGURATION
# ============================================================================
# Rate limiting (requests per 15 minutes)
RATE_LIMIT_MAX=100

# CORS origins (séparés par virgule si plusieurs)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Helmet security headers
HELMET_ENABLED=true

# ============================================================================
# 📊 MONITORING & LOGGING
# ============================================================================
# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Sentry DSN (error tracking) - optionnel
SENTRY_DSN=

# Sentry environment
SENTRY_ENVIRONMENT=production

# Sentry traces sample rate (0.0 - 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1

# Google Analytics - optionnel
GA_ID=

# ============================================================================
# 📧 EMAIL CONFIGURATION (optionnel)
# ============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@pioneeracademy.io

# ============================================================================
# 💾 REDIS CACHE (optionnel - pour scaling avancé)
# ============================================================================
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# ============================================================================
# 🔧 ADVANCED MONGODB OPTIONS
# ============================================================================
# Connection pooling
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=20

# Timeouts (millisecondes)
MONGODB_SOCKET_TIMEOUT=45000
MONGODB_SERVER_SELECTION_TIMEOUT=30000

# Write concern
MONGODB_WRITE_CONCERN=majority

# Read preference
MONGODB_READ_PREFERENCE=secondaryPreferred

# ============================================================================
# 🎮 FEATURE FLAGS
# ============================================================================
ENABLE_PREMIUM=true
ENABLE_STAKING=true
ENABLE_SOCIAL=true
ENABLE_LEADERBOARD=true
ENABLE_MARKETPLACE=true

# ============================================================================
# 📱 MOBILE APP (optionnel)
# ============================================================================
MOBILE_APP_VERSION=1.0.0
MOBILE_FORCE_UPDATE=false

# ============================================================================
# 🌍 LOCALIZATION
# ============================================================================
DEFAULT_LANGUAGE=fr
SUPPORTED_LANGUAGES=fr,en,es

# ============================================================================
# 🧪 TESTING (development only)
# ============================================================================
TEST_MODE=false
MOCK_PI_PAYMENTS=true

# ============================================================================
# 📝 NOTES IMPORTANTES
# ============================================================================
# ⚠️  NE JAMAIS commiter le fichier .env dans Git!
# ⚠️  Utilisez des mots de passe forts (32+ caractères)
# ⚠️  Changez TOUS les secrets avant la production
# ⚠️  Activez SSL/TLS en production
# ⚠️  Whitelist votre IP dans MongoDB Atlas Network Access
#
# ✅ Checklist avant production:
#    □ MONGODB_URI configurée avec vrai cluster
#    □ JWT_SECRET généré sécurisé (64+ chars)
#    □ IP whitelistée dans Atlas
#    □ Database user créé avec permissions appropriées
#    □ PI_API_KEY configurée (production)
#    □ NODE_ENV=production
#    □ FRONTEND_URL correcte
#    □ Monitoring configuré (Sentry)
#
# 📚 Documentation:
#    - MongoDB Atlas: https://docs.atlas.mongodb.com/
#    - Pi Network SDK: https://developers.minepi.com/
#    - Guide complet: ./MONGODB_ATLAS_PRODUCTION_GUIDE.md
