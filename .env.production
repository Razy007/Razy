# 🌍 PRODUCTION ENVIRONMENT VARIABLES - Pioneer Academy
# Ce fichier est utilisé UNIQUEMENT pour le build de production
# Ne jamais commit ce fichier avec des vraies clés API !

# ============================================================================
# PI NETWORK CONFIGURATION (PRODUCTION)
# ============================================================================

# ⚠️ CRITIQUE: sandbox DOIT être false en production !
# true = Testnet (développement)
# false = Mainnet (production)
VITE_PI_SANDBOX=false

# Pi API Key (remplacer par votre vraie clé de production)
# Obtenir depuis Pi Developer Portal: https://develop.pi/
VITE_PI_API_KEY=your_production_api_key_here

# Mock Auth (DOIT être false en production)
VITE_USE_MOCK_AUTH=false

# ============================================================================
# BACKEND API CONFIGURATION
# ============================================================================

# URL de votre backend API (si applicable)
# Pour VPS Hetzner: https://www.pioneeracademy.academy/api
# Ou IP directe: https://116.203.51.124/api
VITE_API_URL=https://www.pioneeracademy.academy/api

# ============================================================================
# PI NETWORK GCV (General Consensus Value)
# ============================================================================

# Valeur de référence Pi Network (ne pas modifier)
VITE_GCV_VALUE=314.159

# ============================================================================
# FIREBASE CONFIGURATION (SI UTILISÉ)
# ============================================================================

# Si vous utilisez Firebase, décommenter et remplir :
# VITE_FIREBASE_API_KEY=your_firebase_api_key
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
# VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# ============================================================================
# NOTES IMPORTANTES
# ============================================================================

# 1. Ce fichier est pour PRODUCTION uniquement
# 2. Pour développement, utiliser .env.development
# 3. Build avec: npm run build
# 4. Les variables sont injectées à la compilation (pas au runtime)
# 5. Toute modification nécessite un rebuild complet

# ============================================================================
# VÉRIFICATION AVANT DÉPLOIEMENT
# ============================================================================

# ✅ VITE_PI_SANDBOX=false
# ✅ VITE_USE_MOCK_AUTH=false
# ✅ VITE_API_URL pointe vers votre VPS
# ✅ VITE_PI_API_KEY rempli avec la vraie clé
