# ============================================================================
# CONFIGURATION MONGODB ATLAS
# ============================================================================

# === Option 1: URI Complete (Recommandé) ===
# Format: mongodb+srv://username:password@cluster/database?options
MONGODB_URI=mongodb+srv://piAcademy:YOUR_PASSWORD@cluster0.y87z9is.mongodb.net/pi_academy?retryWrites=true&w=majority

# === Option 2: Composants Séparés ===
MONGODB_USERNAME=piAcademy
MONGODB_PASSWORD=YOUR_PASSWORD
MONGODB_CLUSTER=cluster0.y87z9is.mongodb.net
MONGODB_DATABASE=pi_academy

# ============================================================================
# CONFIGURATION SERVEUR
# ============================================================================

# Port du serveur backend
PORT=3001

# Environnement (development | production)
NODE_ENV=development

# URL du frontend (pour CORS)
FRONTEND_URL=http://localhost:5173

# ============================================================================
# SÉCURITÉ
# ============================================================================

# Secret JWT (à changer en production!)
JWT_SECRET=pi_academy_ultra_secure_jwt_secret_2025_CHANGE_IN_PRODUCTION

# Salt rounds pour bcrypt
BCRYPT_ROUNDS=10

# Session secret
SESSION_SECRET=pi_academy_session_secret_CHANGE_IN_PRODUCTION

# ============================================================================
# PI NETWORK
# ============================================================================

# Pi Network API Key
PI_API_KEY=your_pi_api_key_here

# Sandbox mode (true pour test, false pour production)
PI_SANDBOX=true

# Pi payment callback URL
PI_PAYMENT_CALLBACK_URL=https://your-domain.com/api/pi/callback

# ============================================================================
# RATE LIMITING
# ============================================================================

# Fenêtre de temps (ms) - 15 minutes par défaut
RATE_LIMIT_WINDOW_MS=900000

# Nombre maximum de requêtes par fenêtre
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

# Niveau de log (error | warn | info | debug)
LOG_LEVEL=info

# Activer logs détaillés MongoDB
MONGODB_LOG_LEVEL=warn

# Sentry DSN (optionnel)
SENTRY_DSN=

# ============================================================================
# FEATURES FLAGS
# ============================================================================

# Activer le staking
ENABLE_STAKING=true

# Activer les retraits
ENABLE_WITHDRAWALS=true

# Activer le social
ENABLE_SOCIAL=true

# Activer KYC automatique
ENABLE_AUTO_KYC=false

# ============================================================================
# PERFORMANCE
# ============================================================================

# Taille du pool de connexions MongoDB
MONGODB_POOL_SIZE_MIN=10
MONGODB_POOL_SIZE_MAX=50

# Timeout de connexion (ms)
MONGODB_CONNECT_TIMEOUT=30000
MONGODB_SOCKET_TIMEOUT=45000

# ============================================================================
# NOTIFICATIONS (optionnel)
# ============================================================================

# Email service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Email from
EMAIL_FROM=noreply@pioneeracademy.com

# ============================================================================
# CACHE (optionnel - Redis)
# ============================================================================

REDIS_URL=redis://localhost:6379
ENABLE_REDIS_CACHE=false

# ============================================================================
# CORS
# ============================================================================

# Origins autorisées (séparées par virgule)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Activer credentials
CORS_CREDENTIALS=true

# ============================================================================
# BACKUP & MAINTENANCE
# ============================================================================

# Activer backup automatique
ENABLE_AUTO_BACKUP=false

# Fréquence de backup (en heures)
BACKUP_FREQUENCY_HOURS=24

# ============================================================================
# DÉVELOPPEMENT UNIQUEMENT
# ============================================================================

# Activer mode debug
DEBUG=false

# Afficher requêtes MongoDB dans console
MONGODB_DEBUG=false

# Désactiver authentification (DANGER - dev uniquement!)
DISABLE_AUTH=false
