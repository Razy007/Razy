# ============================================================================
# PI ACADEMY - BACKEND ENVIRONMENT CONFIGURATION
# ============================================================================
# 
# Instructions :
# 1. Copiez ce fichier et renommez-le en ".env"
# 2. Remplissez les valeurs manquantes
# 3. NE JAMAIS committer le fichier .env sur Git
#
# ============================================================================

# ============================================================================
# MONGODB ATLAS CONFIGURATION
# ============================================================================

# Option 1 : URI Complete (RECOMMANDÉE - Format SRV contourne souvent les blocages)
# Format : mongodb+srv://username:password@cluster/database?options
MONGODB_URI=mongodb+srv://pi_academy_admin:VOTRE_MOT_DE_PASSE@cluster0.y87z9is.mongodb.net/pi_academy?retryWrites=true&w=majority&ssl=true

# Option 2 : Paramètres Séparés (Alternative si URI ne fonctionne pas)
# MONGODB_USERNAME=pi_academy_admin
# MONGODB_PASSWORD=votre_mot_de_passe_ici
# MONGODB_CLUSTER=cluster0.y87z9is.mongodb.net
# MONGODB_DATABASE=pi_academy

# ============================================================================
# SÉCURITÉ
# ============================================================================

# Clé de chiffrement AES-256 pour les données sensibles
# IMPORTANT : Générez une clé aléatoire de 32+ caractères
# Utilisez un générateur de mots de passe sécurisé
# Exemple : https://passwordsgenerator.net/ (32 chars minimum)
ENCRYPTION_KEY=generer_une_cle_aleatoire_securisee_de_32_caracteres_minimum_ici

# JSON Web Token Secret pour authentification
# Générez une autre clé aléatoire de 32+ caractères
JWT_SECRET=generer_une_autre_cle_aleatoire_securisee_de_32_caracteres_minimum

# JWT Expiration (en secondes)
# 86400 = 24h, 604800 = 7 jours, 2592000 = 30 jours
JWT_EXPIRES_IN=604800

# ============================================================================
# SERVEUR
# ============================================================================

# Port du serveur backend
PORT=3001

# Environnement (development, production, test)
NODE_ENV=production

# URL du frontend pour CORS
FRONTEND_URL=http://localhost:5173

# ============================================================================
# PI NETWORK
# ============================================================================

# Utiliser le mode sandbox Pi Network (true pour tests, false pour production)
PI_SANDBOX=true

# Clé API Pi Network (obtenir sur https://developers.minepi.com)
PI_API_KEY=votre_pi_api_key_ici

# URL de l'API Pi Network
PI_API_URL=https://api.minepi.com

# ============================================================================
# RATE LIMITING
# ============================================================================

# Limite de requêtes par IP (requêtes par fenêtre)
RATE_LIMIT_MAX=100

# Fenêtre de temps pour rate limiting (en millisecondes)
# 900000 = 15 minutes, 60000 = 1 minute
RATE_LIMIT_WINDOW_MS=900000

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

# Niveau de log (error, warn, info, debug, verbose)
LOG_LEVEL=info

# Sentry DSN pour tracking d'erreurs (optionnel)
SENTRY_DSN=

# Activer Sentry (true/false)
SENTRY_ENABLED=false

# Taux d'échantillonnage des traces Sentry (0.0 à 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================================
# EMAIL (Optionnel - Pour notifications)
# ============================================================================

# Service email (gmail, sendgrid, etc.)
EMAIL_SERVICE=gmail

# Email expéditeur
EMAIL_USER=

# Mot de passe / API Key
EMAIL_PASSWORD=

# ============================================================================
# BACKUP & RECOVERY (Optionnel)
# ============================================================================

# Activer les backups automatiques
ENABLE_AUTO_BACKUP=false

# Intervalle de backup (en heures)
BACKUP_INTERVAL_HOURS=24

# Destination des backups
BACKUP_PATH=./backups

# ============================================================================
# CACHE (Optionnel - Redis)
# ============================================================================

# URL Redis pour caching (optionnel, améliore performance)
# REDIS_URL=redis://localhost:6379

# Expiration du cache (en secondes)
# CACHE_TTL=3600

# ============================================================================
# ADVANCED SETTINGS (Ne modifier que si vous savez ce que vous faites)
# ============================================================================

# MongoDB Connection Pool
# MONGODB_MAX_POOL_SIZE=100
# MONGODB_MIN_POOL_SIZE=20

# Timeout de connexion MongoDB (ms)
# MONGODB_CONNECT_TIMEOUT_MS=30000
# MONGODB_SOCKET_TIMEOUT_MS=45000

# Retry Logic
# MONGODB_MAX_RETRY_ATTEMPTS=10

# ============================================================================
# NOTES
# ============================================================================

# 📋 CHECKLIST AVANT PRODUCTION :
# 
# [ ] MONGODB_URI configuré avec credentials corrects
# [ ] IP whitelistée dans MongoDB Atlas Network Access
# [ ] ENCRYPTION_KEY généré (32+ chars aléatoires)
# [ ] JWT_SECRET généré (32+ chars aléatoires)
# [ ] NODE_ENV=production
# [ ] PI_SANDBOX=false (si production)
# [ ] PI_API_KEY configuré
# [ ] FRONTEND_URL pointe vers votre domaine de production
# [ ] Firewall autorise port 27017 (MongoDB)
# [ ] SSL/TLS activé
# [ ] Rate limiting configuré
# [ ] Logging configuré
# [ ] Backups automatiques activés
# 
# 🔒 SÉCURITÉ :
# - NE JAMAIS committer le fichier .env sur Git
# - Ajouter .env dans .gitignore
# - Utiliser des clés différentes pour dev/staging/prod
# - Changer les clés régulièrement (tous les 3-6 mois)
# - Stocker les backups des clés dans un gestionnaire de mots de passe
#
# 📚 DOCUMENTATION :
# - Guide complet : MONGODB_ATLAS_SYNC_COMPLETE.md
# - Guide rapide : QUICK_START_MONGODB_ATLAS.md
# - Sécurité : MONGODB_ATLAS_SECURITY_GUIDE.md
