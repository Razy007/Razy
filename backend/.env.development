# Backend Environment Configuration
# ⚠️ IMPORTANT: Copy this file to .env and fill in your actual values

# Server Configuration
PORT=3001
NODE_ENV=development

# Pi Network Configuration
PI_API_KEY=your_pi_api_key_here
PI_SANDBOX=true

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/pi-academy
# Or use MongoDB Atlas (recommended for production):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pi-academy

# Security
# ⚠️ CRITICAL: Generate a strong secret (min 32 characters) for production
JWT_SECRET=pioneer_academy_jwt_secret_change_this_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
